[Unit]
Description=Ouistici configuration server

# Service depends on network
After=network.target

[Service]
ExecStart=/bin/bash -c "source /home/pi/ouistici/bin/activate && python /home/pi/OuisticiBaliseRasp/serverconfig.py"
WorkingDirectory=/home/samuel/OuisticiBaliseRasp/

# Automatically restart the service if it crashes
Restart=on-failure
RestartSec=5

# Uncomment to use a dedicated user (security best practice)
User=ouistici

[Install]
WantedBy=multi-user.target
