[Unit]
Description=Ouistici main app

# Uncomment if your service depends on network
#After=network.target

[Service]
ExecStart=/bin/bash -c "source /home/pi/OuisticiBaliseRasp/ouistici/bin/activate && python /home/pi/OuisticiBaliseRasp/balise_ouistici_2025.py"
WorkingDirectory=/home/pi/OuisticiBaliseRasp/

# Automatically restart the service if it crashes
Restart=on-failure
RestartSec=5

# Use a dedicated user (security best practice)
User=ouistici

[Install]
WantedBy=multi-user.target
